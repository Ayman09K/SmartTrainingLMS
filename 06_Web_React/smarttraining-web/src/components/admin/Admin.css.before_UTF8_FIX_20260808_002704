.admin-actions-grid {
  display: grid;
  gap: 18px;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  margin: 22px 0;
}

.admin-action-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  color: var(--color-text);
  display: block;
  padding: 20px;
  text-decoration: none;
}

.admin-action-card h2 {
  font-size: 18px;
  font-weight: 900;
  margin: 0 0 8px;
}

.admin-action-card p {
  color: var(--color-text-muted);
  line-height: 1.6;
  margin: 0;
}

.admin-form-grid {
  align-items: start;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  margin-bottom: 22px;
  padding: 18px;
}

.admin-form-grid.large {
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
}

.admin-form-grid input,
.admin-form-grid select,
.admin-form-grid textarea,
.admin-toolbar input,
.admin-toolbar select,
.admin-table select {
  border: 1px solid var(--color-border);
  border-radius: 12px;
  font: inherit;
  padding: 11px 12px;
}

.admin-form-grid textarea {
  min-height: 88px;
  resize: vertical;
}

.admin-button {
  align-items: center;
  background: var(--color-primary);
  border: 0;
  border-radius: 12px;
  color: #fff;
  cursor: pointer;
  display: inline-flex;
  font: inherit;
  font-weight: 900;
  justify-content: center;
  padding: 11px 14px;
}

.admin-button.secondary {
  background: #475569;
}

.admin-button.danger {
  background: #dc2626;
}

.admin-button:disabled {
  cursor: not-allowed;
  opacity: 0.65;
}

.admin-success {
  background: #ecfdf5;
  border: 1px solid #bbf7d0;
  border-radius: var(--radius-md);
  color: #166534;
  font-weight: 900;
  margin-bottom: 16px;
  padding: 12px 14px;
}

.admin-toolbar {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin: 14px 0 18px;
}

.admin-inline-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.admin-long-cell {
  max-width: 320px;
  white-space: normal;
}

.admin-token-cell {
  font-family: monospace;
  font-size: 12px;
  max-width: 260px;
  overflow-wrap: anywhere;
}

.admin-empty {
  color: var(--color-text-muted);
  font-weight: 800;
  margin: 18px 0;
}

.admin-section-title {
  font-size: 20px;
  font-weight: 900;
  margin: 28px 0 12px;
}

.admin-cover-thumb {
  border-radius: 10px;
  height: 44px;
  object-fit: cover;
  width: 72px;
}

/* PATCH 10 UX â€” historique et lisibilitÃ© des alertes */
.admin-filter-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 18px 0;
}

.admin-tab-button {
  background: #f8fafc;
  border: 1px solid var(--color-border);
  border-radius: 999px;
  color: var(--color-text);
  cursor: pointer;
  font: inherit;
  font-weight: 800;
  padding: 9px 14px;
}

.admin-tab-button.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}

.admin-tab-button span {
  margin-left: 6px;
  opacity: 0.8;
}

.admin-cell-primary {
  font-weight: 800;
}

.admin-cell-secondary {
  color: var(--color-text-muted);
  font-size: 12px;
  margin-top: 3px;
}

.admin-status-pill {
  border-radius: 999px;
  display: inline-flex;
  font-size: 12px;
  font-weight: 900;
  padding: 6px 9px;
  white-space: nowrap;
}

.admin-status-pill.status-open {
  background: #fff7ed;
  color: #9a3412;
}

.admin-status-pill.status-in_progress {
  background: #eff6ff;
  color: #1d4ed8;
}

.admin-status-pill.status-resolved {
  background: #ecfdf5;
  color: #047857;
}

.admin-status-pill.status-ignored {
  background: #f1f5f9;
  color: #475569;
}