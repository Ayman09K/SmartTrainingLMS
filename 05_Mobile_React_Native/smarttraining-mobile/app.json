                                 "predictiveBackGestureEnabled":  false,
                                 "package":  "com.smarttraininglms.app",
                                 "versionCode":  9
                             },
                 "web":  {
                             "output":  "static",
                             "favicon":  "./assets/branding/SmartTraining_favicon_tab_v2_64.png",
